# Copy this file to .env for local runs. Never commit .env.
# On GitHub, add ANTHROPIC_API_KEY as an Actions secret instead (see the README).

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Lens for documents whose folder doesn't match any lens (file name in /lenses without .md)
DEFAULT_LENS=business

# Read every document again, not just new or changed ones
FORCE_REBUILD=false

# Do everything except write the brain/ folder
DRY_RUN=false

# Long documents are read in parts of this size
MAX_CHUNK_CHARS=15000

# Handbook mode: pages not edited for more than this many days are flagged as possibly out of date
STALE_DAYS=180
